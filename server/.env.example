# ==============================================================================
# ReachInbox Backend Environment Variables (Production & Development Reference)
# ==============================================================================

# Server Environment
NODE_ENV=production
PORT=5000
HOST=0.0.0.0

# Set to "false" on the Render Web Service so the API process does NOT start
# an in-process worker. The dedicated Render Background Worker will execute queue jobs.
# In local development, leave unset or set to "true" to run API + worker together.
RUN_WORKER_IN_PROCESS=false

# Allowed Frontend Origins (CORS)
# Set to your exact Vercel frontend URL(s), comma-separated if multiple:
CORS_ORIGIN=https://reachinbox.vercel.app
ALLOWED_ORIGINS=https://reachinbox.vercel.app
FRONTEND_URL=https://reachinbox.vercel.app

# PostgreSQL Database (Render PostgreSQL or managed Postgres)
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>?schema=public
DATABASE_URL=postgresql://user:password@host:5432/reachinbox_db?schema=public

# Redis Connection (BullMQ Queue Persistence & Atomic Rate Limiter)
# Provide REDIS_URL for Render Redis / Upstash / Cloud Redis:
REDIS_URL=redis://default:password@host:6379
# Alternatively, host/port/password can be provided individually:
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch (Optional - search automatically falls back to PostgreSQL if unavailable)
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_API_KEY=

# Worker Settings
WORKER_CONCURRENCY=5
DEFAULT_MIN_DELAY_SECONDS=2
DEFAULT_MAX_HOURLY_LIMIT=200

# Production SMTP Email Delivery (SendGrid, Mailgun, AWS SES, Postmark, Google Workspace, etc.)
# If SMTP_HOST is omitted, the app falls back to temporary Ethereal SMTP for local dev/testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=ReachInbox Notifications

# Google OAuth 2.0 (Google Identity Services)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# JWT Session Authentication
# Strong secret key (min 32 characters long)
JWT_SECRET=your_jwt_secret_min_32_characters_long_for_production
JWT_EXPIRES_IN=7d

# Slack Integration & OAuth v2
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=https://your-backend.onrender.com/api/auth/slack/callback
# 32-byte hexadecimal encryption key for encrypting Slack bot tokens at rest (AES-256-GCM)
# Generate with: openssl rand -hex 32
SLACK_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

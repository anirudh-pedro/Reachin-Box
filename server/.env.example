# Server
PORT=5000
HOST=0.0.0.0
NODE_ENV=development

# Set to "false" only for the standalone worker process/container (see
# src/worker.ts and npm run dev:worker / start:worker). Leave unset or "true" for
# the API process so local `npm run dev` keeps running API + worker together.
RUN_WORKER_IN_PROCESS=true

# Comma-separated list of frontend origins allowed to call this API (CORS).
# In production, set this to your exact Vercel URL(s), e.g.:
# ALLOWED_ORIGINS=https://reachinbox.vercel.app,https://reachinbox-preview.vercel.app
# If left unset, falls back to FRONTEND_URL (single origin) below.
ALLOWED_ORIGINS=

# PostgreSQL (docker-compose.yml maps the container's 5432 to host port 5433 to avoid
# colliding with any native/locally-installed Postgres already using 5432)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/reachinbox_db?schema=public"

# Redis (BullMQ persistence + rate-limit counters)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Elasticsearch (optional - falls back to PostgreSQL search if unreachable)
ELASTICSEARCH_NODE=http://localhost:9200

# Worker behavior (see README "Concurrency & Rate Limiting" section)
WORKER_CONCURRENCY=5
DEFAULT_MIN_DELAY_SECONDS=2
DEFAULT_MAX_HOURLY_LIMIT=200

# Slack OAuth & Notifications
SLACK_CLIENT_ID=your_slack_client_id
SLACK_CLIENT_SECRET=your_slack_client_secret
SLACK_REDIRECT_URI=http://localhost:5000/api/auth/slack/callback
# 32-byte key for AES-256-GCM token encryption at rest (generate with: openssl rand -hex 32)
SLACK_TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Google OAuth 2.0 (Google Identity Services)
# Web application Client ID from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# JWT Session Authentication
JWT_SECRET=your_jwt_secret_min_32_characters_long_for_production
JWT_EXPIRES_IN=7d

# Frontend origin (used for CORS + OAuth redirect targets)
FRONTEND_URL=http://localhost:5173
